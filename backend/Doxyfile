#---------------------------------------------------------------------------
# Doxygen 1.9.1+ için temel proje ayarları
#---------------------------------------------------------------------------

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "Yazılım Proje Yönetimi"
PROJECT_NUMBER         = 1.0
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES

#---------------------------------------------------------------------------
# Graphviz (DOT) Entegrasyonu
#---------------------------------------------------------------------------

HAVE_DOT               = YES
DOT_PATH               = /usr/bin
DOT_IMAGE_FORMAT       = svg
DOT_TRANSPARENT        = YES
INTERACTIVE_SVG        = YES  # SVG'de yakınlaştırma desteği

# Diyagram ayarları
UML_LOOK               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DIRECTORY_GRAPH        = YES

# Performans optimizasyonları
DOT_GRAPH_MAX_NODES    = 200
DOT_MULTI_TARGETS      = YES
DOT_NUM_THREADS        = 4

#---------------------------------------------------------------------------
# Dokümantasyon kaynakları
#---------------------------------------------------------------------------

INPUT                  = src/
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = *test* */node_modules/*
FILE_PATTERNS          = *.java *.kt *.py *.h *.cpp

#---------------------------------------------------------------------------
# Çıktı detayları
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Kod analiz ayarları
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# Gelişmiş UML ayarları
#---------------------------------------------------------------------------

TEMPLATE_RELATIONS     = YES
INCLUDE_DEPENDENCIES   = YES
GROUP_NESTED_COMPOUNDS = YES
SUBGROUPING            = YES

#---------------------------------------------------------------------------
# Özel DOT stil ayarları (Opsiyonel)
#---------------------------------------------------------------------------

DOT_EXTRA_STYLESHEET   = custom_styles.dot